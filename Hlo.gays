<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amanah - Jual Beli Unchek Akun Game </title>
    <style>
        /* Desain Umum */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    
       { body bg background = "psx_20260502_140855.jpg }
            
            color: #333;
        }
        header {
            background-color: #1e293b;
            color: white;
            padding: 20px;
            text-align: center;
        }
        header h1 {
            margin-bottom: 5px;
        }
        
        /* Wadah Utama */
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* Navigasi / Filter */
        .filter-section {
            margin-bottom: 25px;
            text-align: center;
        }
        .filter-btn {
            background-color: #fff;
            border: 2px solid #1e293b;
            color: #1e293b;
            padding: 8px 16px;
            margin: 5px;
            cursor: pointer;
            border-radius: 20px;
            font-weight: bold;
            transition: 0.3s;
        }
        .filter-btn:hover, .filter-btn.active {
            background-color: #1e293b;
            color: white;
        }

        /* Grid Produk */
        .grid-produk {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        /* Kartu Akun */
        .kartu-akun {
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        .kartu-akun:hover {
            transform: translateY(-5px);
        }
        .info-akun {
            padding: 20px;
        }
        .kategori {
            background-color: #e2e8f0;
            color: #475569;
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 5px;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 10px;
        }
        .judul-akun {
            font-size: 18px;
            margin-bottom: 10px;
            color: #1e293b;
        }
        .detail-spek {
            font-size: 14px;
            color: #64748b;
            margin-bottom: 15px;
            line-height: 1.5;
        }
        .harga {
            font-size: 20px;
            font-weight: bold;
            color: #2563eb;
            margin-bottom: 15px;
        }
        .btn-beli {
            display: block;
            width: 100%;
            background-color: #10b981;
            color: white;
            text-align: center;
            padding: 10px;
            border: none;
            border-radius: 5px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-beli:hover {
            background :"#10b981;
        }

        /* Footer */
        footer {
            background-color: #1e293b;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 40px;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>botakcruell</h1>
        <p>Tempat Aman Jual Beli unchek Game & Aplikasi Premium</p>
    </header>

    <div class="container">
        <!-- Filter Kategori -->
        <div class="filter-section">
            <button class="filter-btn active">Semua</button>
            <button class="filter-btn">Game</button>
            <button class="filter-btn">Streaming</button>
        </div>

        <!-- Grid Daftar Akun -->
        <div class="grid-produk">
            
            <!-- Akun 1 -->
            <div class="kartu-akun">
                <div class="info-akun">
                    <span class="kategori">Game</span>
                    <h3 class="judul-akun">Mobile Legends Mythical Glory</h3>
                    <p class="detail-spek">
                        • Total Hero: 110<br>
                        • Total Skin: 245 (Ada Skin Collector)<br>
                        • Log All Kosong (Aman 100%)
                    </p>
                    <div class="harga">Rp 45.000</div>
                    <button class="btn-beli" onclick="beliunchek('Mobile Legends Mythical Glory', '20.000')">Beli Sekarang</button>
                </div>
            </div>

            <!-- Akun 2 -->
            <div class="kartu-akun">
                <div class="info-akun">
                    <span class="kategori">Streaming</span>
                    <h3 class="judul-akun">Netflix Premium 1 Bulan</h3>
                    <p class="detail-spek">
                        • Durasi: Full 30 Hari<br>
                        • Kualitas: Ultra HD (4K)<br>
                        • Privat Akun (Bukan Sharing)
                    </p>
                    <div class="harga">Rp 45.000</div>
                    <button class="btn-beli" onclick="beliunchek('Netflix Premium 1 Bulan', '45.000')">Beli Sekarang</button>
                </div>
            </div>

            <!-- Akun 3 -->
            <div class="kartu-akun">
                <div class="info-akun">
                    <span class="kategori">Game</span>
                    <h3 class="judul-akun">Genshin Impact AR 55</h3>
                    <p class="detail-spek">
                        • Karakter Bintang 5: 12 (C2 Furina)<br>
                        • Senjata Bintang 5: 5<br>
                        • Ladang Primogem Masih Banyak
                    </p>
                    <div class="harga">Rp 6.000</div>
                    <button class="btn-beli" onclick="unchek('Genshin Impact AR 55', '20.000.00')">Beli Sekarang</button>
                </div>
            </div>

            <!-- Akun 4 -->
            <div class="kartu-akun">
                <div class="info-akun">
                    <span class="kategori">Streaming</span>
                    <h3 class="judul-akun">Spotify Premium 1 1Bulan</h3>
                    <p class="detail-spek">
                        • Durasi: 90 Hari Resmi<br>
                        • Bisa di Akun Sendiri (Via Invite)<br>
                        
                    </p>
                    <div class="harga">Rp 10.000</div>
                    <button class="btn-beli" onclick="unchek game('Spotify 1 Bulan', '25.000')">Beli Sekarang</button>
                </div>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Botakcruell . Hubungi Admin jika ingin mendaftarkan akun Anda.</p>
    </footer>

    <!-- JavaScript Simulasi -->
    <script>
        function beliAkun(namaAkun, harga) {
            // Mengarahkan otomatis ke WhatsApp Admin (Simulasi transaksi nyata)
            const nomorAdmin = "6283862579038"; // Ganti dengan nomor WhatsApp Anda
            const pesan = `Halo Admin, saya ingin membeli akun berikut:\n\n*Nama Akun:* ${namaAkun}\n*Harga:* Rp ${harga}\n\nApakah akun ini masih tersedia?`;
            
            const urlWhatsApp = `https://wa.me{6283862579038}?text=${encodeURIComponent(pesan)}`;
            
            alert(`Anda memilih untuk membeli: ${namaAkun}.\nAnda akan diarahkan ke WhatsApp Admin untuk transaksi aman.`);
            window.open(urlWhatsApp, '_blank');
        }
    </script>
</body>
</html>
